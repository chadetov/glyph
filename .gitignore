# Marketing working set (local only, not part of the repo)
/marketing/

# Engineer feedback notes (local only, not part of the repo)
/feedbacks/

# Local-only project guidance (not part of the repo)
CLAUDE.md

# Git hooks. The active hooks live in .git/hooks/ which git never tracks;
# these patterns also ignore any in-tree hook directory so hooks stay local.
.githooks/
.husky/

# Rust build output
target/
**/*.rs.bk
*.pdb

# Cargo
# (Cargo.lock at the workspace root IS committed because the workspace
# ships a binary crate; per-crate Cargo.lock files in nested manifests
# should not appear.)

# insta pending snapshots awaiting review
*.snap.new

# Editor and IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Local scratchpads
TODO.local.md
NOTES.local.md

# Runtime databases written by example apps (e.g. examples/apps/tasks.glyph)
tasks.db
*.sqlite
*.sqlite3

# Transient files produced by running the example CLI
**/.todos.json

# npm distribution: the per-platform binaries are staged into these dirs by the
# release pipeline (npm/scripts/stage.mjs), never committed. Only the package.json
# templates are tracked.
npm/platform/*/bin/
npm/**/node_modules/

# An example app may depend on real npm packages: proving a working engineer can
# use their existing dependencies is the 1.0 interop gate. The installed tree is
# never committed; CI installs it in the job that builds those apps.
examples/apps/*/node_modules/

# Output an example app writes when it is run. The sitegen app renders a site;
# the pages are a product of running it, not source.
examples/apps/sitegen/site/

# Playground: the WebAssembly bundle is generated by playground/build.sh (and by
# CI for the Pages deploy); never committed.
playground/pkg/

# Local working notes (research, drafts, scratch analysis). Never committed —
# like CLAUDE.md and feedbacks/, this is a private working channel.
/notes/

# Local editor/agent settings. Machine-specific and never useful to anyone else,
# and left untracked it is one `git add -A` away from being committed.
/.claude/

# Python bytecode from the check scripts
__pycache__/
*.pyc
