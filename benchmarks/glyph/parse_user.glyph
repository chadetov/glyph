module parse_user

import std/result { Result, Ok, Err }

type User = { name: string, age: number }

pub fn parse_user(input: unknown) -> Result<User, string> {
  match input {
    is Record<string, unknown> => {
      let name = input["name"]
      let age = input["age"]
      match name {
        is string => match age {
          is number => Ok({ name: name, age: age }),
          else => Err("age: expected number"),
        },
        else => Err("name: expected string"),
      }
    },
    else => Err("expected object"),
  }
}
