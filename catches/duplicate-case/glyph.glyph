module main

fn refundable(status: "paid" | "shipped" | "delivered") -> bool {
  return match status {
    // show
    "paid" => true,
    "shipped" => true,
    "paid" => false,
    // end show
    "delivered" => false,
  }
}

fn main(argv: Array<string>) -> number {
  let r = refundable("paid")
  print("${r}")
  return 0
}
