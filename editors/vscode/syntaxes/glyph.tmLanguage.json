{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Glyph",
  "scopeName": "source.glyph",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#members"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.glyph",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.glyph",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.glyph",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.glyph",
              "match": "\\\\."
            },
            {
              "name": "meta.template.expression.glyph",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.glyph"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.glyph"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.annotation.glyph",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.glyph",
          "match": "\\b(component|fn|import|interface|module|pub|record|type)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.glyph",
          "match": "\\b(async|await|break|continue|defer|else|for|if|in|loop|match|return)\\b"
        },
        {
          "name": "keyword.other.glyph",
          "match": "\\b(as|const|is|let|mut|new|owned|resource|void|where)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.glyph",
          "match": "\\b(false|true)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.glyph",
          "match": "\\b(string|number|int|bigint|bool|unknown|never|void)\\b"
        },
        {
          "name": "entity.name.function.constructor.glyph",
          "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\s*\\()"
        },
        {
          "name": "entity.name.type.glyph",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.glyph",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.glyph",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.glyph",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.glyph",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.glyph",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.union.glyph",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.try.glyph",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.glyph",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.glyph",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "punctuation.accessor.glyph",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.glyph",
          "match": "[,:;]"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.property.glyph",
          "match": "(?<=\\.)\\s*[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
