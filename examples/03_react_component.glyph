// A search-as-you-type component against real React 18:
//   - React's own hooks, imported by name, with a hook's pair destructured
//   - setters are calls, not mutations (no `mut` on set)
//   - restricted JSX expressions
//   - compiler-owned directives: <if>, <for>, <match>, <case>, <else>

module components/user_search

import react { useState, useEffect, useMemo }
import std/result { Result, Ok, Err }
import std/time
import std/time { Duration }

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

type User = { id: string, name: string, email: string }

type SearchState =
  | Idle
  | Loading
  | Loaded({ users: Array<User> })
  | Failed({ message: string })

type Props = {
  search: fn(query: string) -> Result<Array<User>, string>,
  on_select: fn(user: User) -> void,
  placeholder?: string,
}

// ---------------------------------------------------------------------------
// Component
// ---------------------------------------------------------------------------

pub component UserSearch(props: Props) -> Component {
  let [query, set_query] = useState("")
  let [state, set_state] = useState<SearchState>(Idle)

  // One debounced function for the component's lifetime, so a burst of
  // keystrokes runs one search.
  let debounced_search = useMemo(
    fn() {
      return time.debounce(Duration.ms(250), fn(q: string) { set_state(outcome(props.search(q))) })
    },
    [],
  )

  // An effect returns nothing: a value it returned would reach React as a
  // cleanup function.
  useEffect(
    fn() -> void {
      match query.length {
        0 => set_state(Idle),
        else => {
          set_state(Loading)
          debounced_search(query)
        },
      }
    },
    [query],
  )

  return <div class="user-search">
    <input type="text" value={query} placeholder={props.placeholder ?? "Search users..."} on_change={fn(
      event,
    ) { set_query(event.currentTarget.value) }} />
    <ResultsList state={state} on_select={props.on_select} />
  </div>
}

// ---------------------------------------------------------------------------
// Subcomponent
// ---------------------------------------------------------------------------

type ResultsListProps = { state: SearchState, on_select: fn(user: User) -> void }

component ResultsList(props: ResultsListProps) -> Component {
  return <match value={props.state}>
    <case Idle>
      <p class="hint">Start typing to search.</p>
    </case>
    <case Loading>
      <p class="hint">Searching...</p>
    </case>
    <case Loaded({ users })>
      <if cond={users.length == 0}>
        <p class="hint">No users found.</p>
      </if>
      <else>
        <ul class="results">
          <for user in={users} key={user.id}>
            <li on_click={fn() { props.on_select(user) }}>
              <span class="name">{user.name}</span>
              <span class="email">{user.email}</span>
            </li>
          </for>
        </ul>
      </else>
    </case>
    <case Failed({ message })>
      <p class="error">{message}</p>
    </case>
  </match>
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn outcome(found: Result<Array<User>, string>) -> SearchState {
  return match found {
    Ok(users) => Loaded({ users: users }),
    Err(message) => Failed({ message: message }),
  }
}
