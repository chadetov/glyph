// adventure — a ten-room text adventure with a keyed world, a command parser,
// conditional world rules, and a validating save file.
//
// Play it:
//   glyph run examples/apps/adventure.glyph
//
// Or pipe a script, which plays deterministically to completion:
//   printf 'north\ntake lantern\ndown\nlook\nquit\n' \
//     | glyph run examples/apps/adventure.glyph

module adventure

import std/result { Result, Ok, Err }
import std/option { Option, Some, None }
import std/array
import std/string
import std/record
import std/json
import std/fs
import std/io

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

type Item = {
  id: string,
  name: string,
  description: string,
  // False for scenery: it is examinable and matchable, but it stays put.
  takeable: bool,
}

type Room = {
  id: string,
  title: string,
  description: string,
  // direction -> destination room id. Every destination is a key of World.rooms,
  // never a Room value, so there is exactly one copy of each room.
  exits: Record<string, string>,
  // direction -> item id that must be in the inventory to use that exit.
  locks: Record<string, string>,
  // Item ids present in the room. The Item itself lives in World.items.
  items: Array<string>,
  // Fires once, the first time the room is entered.
  on_enter: Option<string>,
}

type Player = {
  location: string,
  // Item ids. Same keyed-store rule as Room.items.
  inventory: Array<string>,
}

type World = {
  rooms: Record<string, Room>,
  items: Record<string, Item>,
  player: Player,
  // World state that is not a room or an item: what has been visited, lit,
  // opened. Read by descriptions and by the win check.
  flags: Record<string, bool>,
  moves: int,
  collected: int,
  won: bool,
}

const WRAP_WIDTH: int = 66

const SAVE_PATH: string = "adventure-save.json"

// Carrying this item into this room, with the altar open, wins the game.
const WIN_ITEM: string = "idol"

const WIN_ROOM: string = "shrine"

// ---------------------------------------------------------------------------
// The world, as data
// ---------------------------------------------------------------------------

