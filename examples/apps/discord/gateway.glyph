// The socket and the clock.
//
// Everything the bot decides is decided in `session`, as a pure function from
// one event to a new session and a list of actions. This file is the part that
// cannot be a value: it opens the WebSocket, runs the heartbeat timer, and
// carries out those actions. It holds no protocol logic, which is why the hard
// parts (resume, zombie detection, backoff) are checked by `@example` rather
// than by provoking a real outage.
//
// It is ordinary Glyph. `std/websocket` and `std/timers` cover what an earlier
// version of this file reached for through six escapes to raw TypeScript and a
// hand-written declaration file, because the host's `WebSocket` and its timers
// are globals and Glyph resolves imported module names rather than ambient
// globals. Every callback parameter below is typed, and there is no line in the
// app that a TypeScript compiler would have to be trusted with.
//
// The connection lives in a `Conn` record threaded through top-level functions
// rather than in closures over `let` bindings. It has to: `connect` schedules a
// reconnect, which calls `connect` again, and a `let`-bound closure cannot be
// named before the line that binds it, so the cycle is unwritable that way.
// Passing one record round also means `grep -n "^\s*mut conn\."` lists every
// piece of connection state that ever changes.
//
// The socket is a `resource type` (D25), so the compiler checks the part of its
// lifetime that a socket program gets wrong: a handle that is created and then
// not handed anywhere, and a handle that is taken back out and then not closed.
// `grep -n owned gateway.glyph` is the whole ownership surface: two bindings
// and two consuming parameters. What the compiler cannot see is the middle,
// while the handle sits in `Conn.socket` waiting for an event that may never
// arrive, because `owned` is checked inside a function body and a socket in an
// event-driven program outlives every stack frame it passes through. The two
// ends are what this file makes structural: `take_socket` is the only way to
// get a handle back out of the record and it clears the field as it goes, so a
// socket cannot be closed and left installed, or left installed and never
// closed.
module gateway

import std/io
import std/option { Option, Some, None }
import std/process
import std/string
import std/timers
import std/timers { Timer }
import std/websocket
import std/websocket { Socket }
import backoff
import backoff { Backoff }
import protocol
import session
import session { Session, Action, Step }

// The socket, as something with an owner.
//
// A WebSocket is the case D25 was written for: it has to be closed exactly
// once, and the paths that forget are the ones nobody exercises. Marking it
// `resource` is what lets `owned` be spelled on it at all, and what turns
// "we close it in the reconnect path too" from a comment into E0206.
resource type Wire = Socket

// Everything about the current connection that outlives a single callback.
type Conn = {
  url: string,
  verbose: bool,
  socket: Option<Wire>,
  heartbeat: Option<Timer>,
  state: Session,
  retry: Backoff,
  // Which connection attempt is the current one.
  //
  // A socket this bot has written off stays open at the TCP level until it is
  // closed, and its handlers stay registered either way. Without an identity to
  // compare against, a late frame or a delayed close from the abandoned socket
  // would be applied to the connection that replaced it: the worst version
  // tears down a healthy connection when a zombie finally times out. Each
  // `connect` captures the generation it was started under and ignores
  // everything once it is no longer current.
  generation: int,
}

// Run the bot until the process is killed.
//
// This returns as soon as the first socket is opened. The process stays alive
// afterwards because the socket and the heartbeat timer are pending work, the
// same reason any Node server keeps running.
pub fn run(url: string, token: string, verbose: bool) {
  let conn: Conn = {
    url: url,
    verbose: verbose,
    socket: None,
    heartbeat: None,
    state: session.start(token),
    retry: backoff.fresh(),
    generation: 0,
  }
  connect(conn)
}

fn connect(conn: Conn) {
  // Whatever is still installed belongs to an attempt this one replaces. The
  // session asks for a close before every reconnect it schedules, so normally
  // there is nothing here; doing it anyway means a second socket cannot come
  // into existence while the first one is still held, whatever route got here.
  close_socket(conn)

  mut conn.generation = conn.generation + 1
  let mine = conn.generation
  // Whatever happens to this attempt is a fresh event, so the session stops
  // treating further closes as the tail of the decision that scheduled it.
  mut conn.state = session.attempting(conn.state)

  // From here to `keep` below, this handle belongs to this function, and the
  // compiler will not let the function end without giving it away.
  let owned sock: Wire = websocket.connect(conn.url)

  websocket.on_open(sock, fn() {
    match current(conn, mine) {
      false => {},
      true => {
        say(conn, "socket open")
        mut conn.retry = backoff.succeeded(conn.retry)
      },
    }
  })

  websocket.on_message(sock, fn(text) {
    match current(conn, mine) {
      false => {},
      true => advance(conn, session.receive(conn.state, protocol.read(text))),
    }
  })

  // The close code is what separates an outage worth waiting out from a
  // rejection that will be rejected identically forever, so it is handed to the
  // session rather than summarized here.
  websocket.on_close(sock, fn(code, reason) {
    match current(conn, mine) {
      false => {},
      true => advance(conn, session.disconnected(conn.state, code, close_reason(reason))),
    }
  })

  // An error is always followed by a close, and the close is where the
  // reconnect is decided, so this only reports.
  websocket.on_error(sock, fn() {
    match current(conn, mine) {
      false => {},
      true => say(conn, "socket error"),
    }
  })

  // The handlers above borrow the socket. This is the line that gives it away:
  // the connection holds it from here, and the only way back out is
  // `take_socket`, which hands it to something that has to close it.
  keep(conn, sock)
}

// The connection takes the socket.
fn keep(conn: Conn, owned sock: Wire) {
  mut conn.socket = Some(sock)
}

// Take the installed socket, leaving nothing behind.
//
// Clearing the field here rather than at the call site is what makes the
// record's slot and the handle the same fact: there is no order of statements
// that closes a socket the connection is still pointing at.
fn take_socket(conn: Conn) -> Option<Wire> {
  let held = conn.socket
  mut conn.socket = None
  return held
}

// Hang up.
fn hang_up(owned sock: Wire) {
  websocket.close(sock)
}

// Whether the socket a handler belongs to is still the one in use.
fn current(conn: Conn, generation: int) -> bool {
  return conn.generation == generation
}

// A close with no reason still needs something to print.
fn close_reason(reason: string) -> string {
  return match string.len(reason) == 0 {
    true => "socket closed",
    false => reason,
  }
}

// A step from the protocol layer: adopt the new session, then do what it asked,
// in the order it asked.
fn advance(conn: Conn, taken: Step) {
  mut conn.state = taken.session
  for action in taken.actions {
    perform(conn, action)
  }
}

// Carrying out one action. The protocol layer decided it; nothing here
// second-guesses it.
fn perform(conn: Conn, action: Action) {
  match action {
    session.Send({ frame }) => send(conn, frame),
    session.Note({ line }) => say(conn, line),
    session.StartHeartbeat({ interval }) => {
      stop_heartbeat(conn)
      mut conn.heartbeat = Some(timers.every(interval, fn() {
        advance(conn, session.tick(conn.state))
      }))
      say(conn, "heartbeat every ${number.to_string(interval)}ms")
    },
    session.StopHeartbeat => stop_heartbeat(conn),
    session.CloseSocket => close_socket(conn),
    session.Reconnect({ resume }) => schedule_reconnect(conn, resume),
    // A failure retrying cannot fix. Reporting it and exiting non-zero is the
    // only useful thing left: `main` returned long ago, so nothing else would.
    session.Stop({ reason }) => {
      io.eprintln("discord: ${reason}")
      process.exit(1)
    },
    // A real bot POSTs this to the REST API. Printing it keeps the example
    // runnable against a mock gateway and with no credentials.
    session.Reply({ channel, text }) => io.println("reply to ${channel}: ${text}"),
  }
}

fn schedule_reconnect(conn: Conn, resume: bool) {
  mut conn.retry = backoff.failed(conn.retry)
  let delay = backoff.wait_ms(conn.retry)
  say(conn, "reconnecting in ${number.to_string(delay)}ms (resume=${yes_no(resume)})")
  let _ = timers.after(delay, fn() { connect(conn) })
}

// A send into a socket the network has just dropped reports rather than
// throwing, so a frame racing a disconnect is a log line and not a crash on a
// callback stack this program does not own.
fn send(conn: Conn, frame: string) {
  match conn.socket {
    Some(sock) => match websocket.send(sock, frame) {
      true => {},
      false => say(conn, "dropped a frame: the socket is not open"),
    },
    None => say(conn, "dropped a frame: no socket"),
  }
}

// Hang up, and stop listening to what we hung up on. The generation bump is
// what silences the handlers: they cannot be detached without holding each
// closure, and a socket that closes later must not reach the session.
//
// The `let owned` is where the handle becomes this function's responsibility
// again. Adding a `return` above the `hang_up` line, or losing that line in a
// refactor, is E0206 rather than a socket left open until the process dies.
fn close_socket(conn: Conn) {
  match take_socket(conn) {
    Some(held) => {
      mut conn.generation = conn.generation + 1
      let owned sock: Wire = held
      hang_up(sock)
    },
    None => {},
  }
}

fn stop_heartbeat(conn: Conn) {
  match conn.heartbeat {
    Some(handle) => {
      timers.cancel(handle)
      mut conn.heartbeat = None
    },
    None => {},
  }
}

fn say(conn: Conn, line: string) {
  match conn.verbose {
    true => io.println(line),
    false => {},
  }
}

fn yes_no(value: bool) -> string {
  return match value {
    true => "yes",
    false => "no",
  }
}
