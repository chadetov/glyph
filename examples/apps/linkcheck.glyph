// linkcheck — a markdown link checker.
//
// Walks one or more markdown files (or a directory of them), pulls every link
// out of the prose, and reports the ones that are broken. Inline links,
// reference definitions, bare autolinks, and image sources all count; links
// inside a fenced code block or an inline code span do not, because a URL in a
// snippet is documentation, not a claim.
//
// Every link carries the file and 1-based line it came from, so the report
// names a place you can jump to. Relative links are resolved against the
// containing file's directory and checked on disk; a `file.md#anchor` link is
// resolved by reading the target and matching the anchor against its headings,
// slugified the way GitHub does. External links are fetched once per unique URL
// through a bounded pool, and the single answer is fanned back out to every
// occurrence.
//
// Usage:
//   linkcheck <file.md | dir> [more...] [--offline] [--max-concurrency N]
//
// `--offline` skips every network check, which makes a run deterministic (and
// is what the example invocation below uses). Exit status is 1 when anything is
// broken, 0 otherwise, so it drops straight into CI.
//
// Run it end to end (copy the whole block):
//
//   mkdir -p /tmp/lc/guide
//   cat > /tmp/lc/README.md <<'EOF'
//   # Project
//
//   Read the [guide](guide/intro.md) and the [install steps](guide/intro.md#getting-started).
//   The [changelog](CHANGELOG.md) is missing on purpose.
//   Homepage: <https://example.com>. Mail us at <mailto:hi@example.com>.
//
//   ```sh
//   curl https://not-a-real-host.invalid/skip-me
//   ```
//
//   Inline `[code](never.md)` is left alone. Jump to [#project](#project).
//
//   ![logo](guide/logo.png)
//
//   [spec]: guide/intro.md#deep-dive
//   EOF
//   cat > /tmp/lc/guide/intro.md <<'EOF'
//   # Intro
//
//   ## Getting Started
//
//   Back to the [README](../README.md).
//   EOF
//   glyph run examples/apps/linkcheck.glyph /tmp/lc --offline

module main

import std/array
import std/fs
import std/http
import std/io
import std/math
import std/option { Option, Some, None }
import std/path
import std/process
import std/record
import std/regex
import std/result { Result, Ok, Err }
import std/set
import std/string
import std/task
import std/time
import std/time { Duration }

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

// What a link target turned out to be. Everything downstream matches on this,
// so a new link shape cannot be silently ignored.
type LinkKind =
  | External({ url: string })
  | RelativeFile({ target: string, anchor: Option<string> })
  | InPageAnchor({ slug: string })
  | OtherScheme({ scheme: string })
  | Malformed({ reason: string })

// One link occurrence, with the place it was written.
type Link = { file: string, line: int, target: string, is_image: bool, kind: LinkKind }

// What checking a link concluded. Network answers and filesystem answers live
// in the same union because the report treats them the same way.
type Outcome =
  | Alive({ code: int })
  | Redirect({ code: int, location: string })
  | ClientError({ code: int })
  | ServerFault({ code: int })
  | NetworkFail({ message: string })
  | TimedOut
  | LocalMissing({ resolved: string })
  | AnchorMissing({ slug: string, resolved: string })
  | Bad({ reason: string })
  | Skipped({ reason: string })

type Checked = {
  link: Link,
  outcome: Outcome,
  // True when the answer came from the shared cache rather than a fresh fetch.
  cached: bool,
}

// A file we could not even open. Reported as a row, not a crash.
type FileError = { path: string, message: string }

type Args = { paths: Array<string>, offline: bool, max_concurrency: int }

type ArgError =
  | NoPaths
  | MissingValue({ flag: string })
  | BadNumber({ flag: string, value: string })
  | UnknownFlag({ flag: string })

type Tally = { checked: int, ok: int, broken: int, skipped: int, cached: int }

// ---------------------------------------------------------------------------
// Text helpers the standard library does not have
// ---------------------------------------------------------------------------

const SPACE = " "

const EMPTY = ""

const NEWLINE = "\n"

const HASH = "#"

const LOWER = "abcdefghijklmnopqrstuvwxyz"

const DIGITS = "0123456789"

fn widest(values: Array<string>) -> int {
  return array.fold(values, 0, fn(w: int, v: string) -> int { return math.max(w, string.len(v)) })
}

// `array.sort` takes the comparator, so lexicographic order has to be spelled.
@example compare_text("a", "b") == 0 - 1
@example compare_text("b", "b") == 0
fn compare_text(a: string, b: string) -> number {
  return match a < b {
    true => 0 - 1,
    false => match a == b {
      true => 0,
      false => 1,
    },
  }
}

// ---------------------------------------------------------------------------
// GitHub-style heading slugs
// ---------------------------------------------------------------------------

// Lowercase, spaces to hyphens, everything that is not a letter, digit, hyphen
// or underscore dropped. This is the rule GitHub applies to a heading before it
// becomes an `#anchor`.
@example slugify("  Trim Me  ") == "trim-me"
@example slugify("API v2.0 (beta)") == "api-v20-beta"
@example slugify("Getting Started") == "getting-started"
@example slugify("Hello, World!") == "hello-world"
@example slugify("snake_case and dash-case") == "snake_case-and-dash-case"
fn slugify(heading: string) -> string {
  let lowered = string.lower(string.trim(heading))
  return array.fold(
    string.split(lowered, EMPTY),
    EMPTY,
    fn(out: string, c: string) -> string {
      return match c == SPACE {
        true => "${out}-",
        false => match keeps_in_slug(c) {
          true => "${out}${c}",
          false => out,
        },
      }
    },
  )
}

fn keeps_in_slug(c: string) -> bool {
  return string.contains(LOWER, c) || string.contains(DIGITS, c) || c == "-" || c == "_"
}

// Every `#`-prefixed heading in a markdown document, slugified. Headings inside
// a fenced code block do not count, for the same reason links there do not.
fn heading_slugs(text: string) -> Array<string> {
  let slugs: Array<string> = []
  let in_fence = false
  let lines: Array<string> = string.split(text, NEWLINE)
  for raw in lines {
    let line = string.trim(raw)
    let fence = is_fence(line)
    mut in_fence = match fence {
      true => !in_fence,
      false => in_fence,
    }
    mut slugs = match in_fence || fence {
      true => slugs,
      false => match string.starts_with(line, HASH) {
        true => array.push(slugs, slugify(strip_hashes(line))),
        false => slugs,
      },
    }
  }
  return slugs
}

fn is_fence(trimmed: string) -> bool {
  return string.starts_with(trimmed, "```") || string.starts_with(trimmed, "~~~")
}

@example strip_hashes("## Getting Started") == "Getting Started"
fn strip_hashes(line: string) -> string {
  let n = string.len(line)
  let i = 0
  loop {
    match i < n && string.slice(line, i, i + 1) == HASH {
      false => { break },
      true => { mut i = i + 1 },
    }
  }
  return string.trim(string.slice(line, i))
}

// ---------------------------------------------------------------------------
// Link extraction
// ---------------------------------------------------------------------------

type RawLink = { line: int, target: string, is_image: bool }

// Pull every link out of a markdown document. Fenced blocks are skipped whole;
// inline code spans are skipped as the scanner walks a line.
fn extract(text: string) -> Array<RawLink> {
  return array.flat_map(
    prose_lines(text),
    fn(l: NumberedLine) -> Array<RawLink> { return scan_line(l.text, l.lineno) },
  )
}

// A source line and its 1-based number.
type NumberedLine = { lineno: int, text: string }

// Every line outside a fenced code block. The fence state is why this is a loop
// and not a filter: whether a line counts depends on every line before it.
fn prose_lines(text: string) -> Array<NumberedLine> {
  let out: Array<NumberedLine> = []
  let in_fence = false
  let lineno = 0
  for raw in string.split(text, NEWLINE) {
    mut lineno = lineno + 1
    let fence = is_fence(string.trim(raw))
    mut in_fence = match fence {
      true => !in_fence,
      false => in_fence,
    }
    match in_fence || fence {
      true => {},
      false => { mut out.push({ lineno: lineno, text: raw }) },
    }
  }
  return out
}

// Every inline link shape on one line, in one alternation. Ordered so a code
// span wins: `[link](x)` between backticks is consumed by group 1 and never
// reaches the others, which is how a renderer reads it too.
//
//   1  an inline code span, terminated or running to the end of the line
//   2  the whole `[text](target)` construct, with a leading `!` for an image
//   3  the target inside group 2
//   4  the whole `<autolink>`, which has to carry a scheme to count
//
// Groups 2 and 4 are the discriminators, not 3, because `captures_all` reports a
// group that did not participate as `""`. An empty target (`[]()`) and a branch
// that never fired would read the same; a group that starts with `[`, `!` or `<`
// cannot be empty when it does fire.
const INLINE_LINK = "(`[^`]*`?)|(!?\\[[^\\]]*\\]\\(([^)]*)\\))|(<[^>]*://[^>]*>|<mailto:[^>]*>)"

// `[id]: https://example.com "optional title"`, anchored to the start of a line.
// Group 1 is everything after the colon.
const REF_DEF = "^\\[[^\\]]*\\]:(.*)$"

fn scan_line(line: string, lineno: int) -> Array<RawLink> {
  return match reference_definition(line, lineno) {
    Some(def) => [def],
    None => scan_inline(line, lineno),
  }
}

// `[id]: https://example.com "optional title"` — a link with no surrounding
// prose, only legal at the start of a line.
fn reference_definition(line: string, lineno: int) -> Option<RawLink> {
  let groups = regex.captures(REF_DEF, line)
  return match array.len(groups) == 0 {
    true => None,
    false => match string.trim(groups[0]) == EMPTY {
      true => None,
      false => Some({ line: lineno, target: clean_target(groups[0]), is_image: false }),
    },
  }
}

// One regex pass per line. `captures_all` hands back the groups of every match
// in source order, and which group is non-empty says which shape fired.
fn scan_inline(line: string, lineno: int) -> Array<RawLink> {
  return array.flat_map(
    regex.captures_all(INLINE_LINK, line),
    fn(groups: Array<string>) -> Array<RawLink> { return link_of(groups, lineno) },
  )
}

fn link_of(groups: Array<string>, lineno: int) -> Array<RawLink> {
  return match groups[1] != EMPTY {
    true => [
      {
        line: lineno,
        target: clean_target(groups[2]),
        is_image: string.starts_with(groups[1], "!"),
      },
    ],
    false => match groups[3] != EMPTY {
      true => [{ line: lineno, target: unwrap_angles(groups[3]), is_image: false }],
      // Group 1 fired: an inline code span, which contributes no links.
      false => [],
    },
  }
}

@example unwrap_angles("<https://example.com>") == "https://example.com"
fn unwrap_angles(raw: string) -> string {
  return string.slice(raw, 1, string.len(raw) - 1)
}

// Strip an optional title and an angle-bracket wrapper: `<a.md> "Title"` is a
// link to `a.md`.
@example clean_target("<a.md>") == "a.md"
@example clean_target("a.md") == "a.md"
fn clean_target(raw: string) -> string {
  let first = array.slice(string.split(string.trim(raw), SPACE), 0, 1)
  let head = string.join(first, EMPTY)
  let stripped = match string.starts_with(head, "<") && string.ends_with(head, ">") {
    true => string.slice(head, 1, string.len(head) - 1),
    false => head,
  }
  return stripped
}

// ---------------------------------------------------------------------------
// Classification
// ---------------------------------------------------------------------------

@example kind_label(classify("")) == "malformed"
@example kind_label(classify("#heading")) == "anchor"
@example kind_label(classify("./docs.md")) == "relative"
@example kind_label(classify("https://example.com")) == "external"
@example kind_label(classify("mailto:a@b.c")) == "scheme"
fn classify(target: string) -> LinkKind {
  return match target == EMPTY {
    true => Malformed({ reason: "empty target" }),
    false => match string.starts_with(target, HASH) {
      true => InPageAnchor({ slug: slugify(string.slice(target, 1)) }),
      false => classify_non_anchor(target),
    },
  }
}

fn classify_non_anchor(target: string) -> LinkKind {
  let http = string.starts_with(target, "http://") || string.starts_with(target, "https://")
  return match http {
    true => External({ url: target }),
    false => match string.contains(target, "://") {
      true => OtherScheme({ scheme: scheme_of(target) }),
      false => match bare_scheme(target) {
        Some(s) => OtherScheme({ scheme: s }),
        None => relative_kind(target),
      },
    },
  }
}

fn scheme_of(target: string) -> string {
  return string.join(array.slice(string.split(target, "://"), 0, 1), EMPTY)
}

// `mailto:a@b.c`, `tel:+1`, `ftp:...` — a scheme is letters followed by a colon
// before any slash.
fn bare_scheme(target: string) -> Option<string> {
  return match string.index_of(target, ":") {
    None => None,
    Some(colon) => {
      let before_slash = colon > 0 && match string.index_of(target, "/") {
        None => true,
        Some(slash) => colon < slash,
      }
      match before_slash {
        false => None,
        true => {
          let head = string.lower(string.slice(target, 0, colon))
          match all_letters(head) {
            true => Some(head),
            false => None,
          }
        },
      }
    },
  }
}

fn all_letters(s: string) -> bool {
  return string.len(s) > 0 && array.fold(
    string.split(s, EMPTY),
    true,
    fn(ok: bool, c: string) -> bool { return ok && string.contains(LOWER, c) },
  )
}

fn relative_kind(target: string) -> LinkKind {
  let parts: Array<string> = string.split(target, HASH)
  let head = string.join(array.slice(parts, 0, 1), EMPTY)
  let tail = string.join(array.slice(parts, 1, array.len(parts)), HASH)
  return match string.contains(head, SPACE) {
    true => Malformed({ reason: "whitespace in path" }),
    false => match tail == EMPTY {
      true => RelativeFile({ target: head, anchor: None }),
      false => RelativeFile({ target: head, anchor: Some(slugify(tail)) }),
    },
  }
}

fn kind_label(kind: LinkKind) -> string {
  return match kind {
    External({ url }) => "external",
    RelativeFile({ target, anchor }) => "relative",
    InPageAnchor({ slug }) => "anchor",
    OtherScheme({ scheme }) => "scheme",
    Malformed({ reason }) => "malformed",
  }
}

// ---------------------------------------------------------------------------
// Local resolution
// ---------------------------------------------------------------------------

// A relative link resolves against the directory of the file that wrote it.
@example resolve_relative("README.md", "guide/intro.md") == "guide/intro.md"
@example resolve_relative("docs/guide/a.md", "../b.md") == "docs/b.md"
fn resolve_relative(from_file: string, target: string) -> string {
  return path.normalize(path.join([path.dirname(from_file), target]))
}

fn check_relative(from_file: string, target: string, anchor: Option<string>) -> Outcome {
  let resolved = resolve_relative(from_file, target)
  return match fs.exists(resolved) {
    false => LocalMissing({ resolved: resolved }),
    true => match anchor {
      None => Alive({ code: 0 }),
      Some(slug) => check_anchor_in(resolved, slug),
    },
  }
}

fn check_anchor_in(resolved: string, slug: string) -> Outcome {
  return match fs.read_text(resolved) {
    Err(e) => Bad({ reason: "cannot read ${resolved}: ${e.message}" }),
    Ok(text) => match array.contains(heading_slugs(text), slug) {
      true => Alive({ code: 0 }),
      false => AnchorMissing({ slug: slug, resolved: resolved }),
    },
  }
}

fn check_in_page(text: string, slug: string, file: string) -> Outcome {
  return match array.contains(heading_slugs(text), slug) {
    true => Alive({ code: 0 }),
    false => AnchorMissing({ slug: slug, resolved: file }),
  }
}

// ---------------------------------------------------------------------------
// External checks
// ---------------------------------------------------------------------------

const TIMEOUT_MS = 8000

async fn check_external(url: string) -> Outcome {
  return await task.race([fn() { fetch_outcome(url) }, fn() { timeout_outcome() }])
}

async fn fetch_outcome(url: string) -> Outcome {
  return match await http.get(url) {
    Ok(response) => from_status(response.status),
    // A non-2xx status arrives as an `Err` carrying the status; a thrown fetch
    // (DNS failure, refused connection) arrives with status 0.
    Err(e) => match e.status == 0 {
      true => NetworkFail({ message: first_line(e.message) }),
      false => from_status(e.status),
    },
  }
}

async fn timeout_outcome() -> Outcome {
  await time.sleep(Duration.ms(TIMEOUT_MS))
  return TimedOut
}

fn from_status(code: int) -> Outcome {
  return match code < 300 {
    true => Alive({ code: code }),
    false => match code < 400 {
      // `std/http` follows redirects and does not expose the response URL or
      // headers, so this arm is only reachable if a 3xx ever surfaces directly.
      true => Redirect({ code: code, location: "?" }),
      false => match code < 500 {
        true => ClientError({ code: code }),
        false => ServerFault({ code: code }),
      },
    },
  }
}

fn first_line(message: string) -> string {
  return string.trim(string.join(array.slice(string.split(message, NEWLINE), 0, 1), EMPTY))
}

// ---------------------------------------------------------------------------
// Outcome vocabulary
// ---------------------------------------------------------------------------

fn is_broken(outcome: Outcome) -> bool {
  return match outcome {
    Alive({ code }) => false,
    Redirect({ code, location }) => false,
    Skipped({ reason }) => false,
    ClientError({ code }) => true,
    ServerFault({ code }) => true,
    NetworkFail({ message }) => true,
    TimedOut => true,
    LocalMissing({ resolved }) => true,
    AnchorMissing({ slug, resolved }) => true,
    Bad({ reason }) => true,
  }
}

fn is_skipped(outcome: Outcome) -> bool {
  return match outcome {
    Skipped({ reason }) => true,
    Alive({ code }) => false,
    Redirect({ code, location }) => false,
    ClientError({ code }) => false,
    ServerFault({ code }) => false,
    NetworkFail({ message }) => false,
    TimedOut => false,
    LocalMissing({ resolved }) => false,
    AnchorMissing({ slug, resolved }) => false,
    Bad({ reason }) => false,
  }
}

fn status_tag(outcome: Outcome) -> string {
  return match outcome {
    Alive({ code }) => "OK",
    Redirect({ code, location }) => "REDIRECT",
    ClientError({ code }) => "BROKEN",
    ServerFault({ code }) => "SERVER",
    NetworkFail({ message }) => "NETWORK",
    TimedOut => "TIMEOUT",
    LocalMissing({ resolved }) => "MISSING",
    AnchorMissing({ slug, resolved }) => "NO-ANCHOR",
    Bad({ reason }) => "MALFORMED",
    Skipped({ reason }) => "SKIP",
  }
}

fn status_detail(outcome: Outcome) -> string {
  return match outcome {
    Alive({ code }) => match code == 0 {
      true => EMPTY,
      false => "${number.to_string(code)}",
    },
    Redirect({ code, location }) => "${number.to_string(code)} -> ${location}",
    ClientError({ code }) => number.to_string(code),
    ServerFault({ code }) => number.to_string(code),
    NetworkFail({ message }) => message,
    TimedOut => "no response in ${number.to_string(TIMEOUT_MS)}ms",
    LocalMissing({ resolved }) => "no file at ${resolved}",
    AnchorMissing({ slug, resolved }) => "no heading #${slug} in ${resolved}",
    Bad({ reason }) => reason,
    Skipped({ reason }) => reason,
  }
}

// ---------------------------------------------------------------------------
// Loading files
// ---------------------------------------------------------------------------

type Document = { path: string, text: string }

type Loaded = { documents: Array<Document>, errors: Array<FileError> }

fn empty_loaded() -> Loaded {
  return { documents: [], errors: [] }
}

fn load_all(paths: Array<string>) -> Loaded {
  return array.fold(paths, empty_loaded(), load_one)
}

fn load_one(acc: Loaded, p: string) -> Loaded {
  return match fs.is_dir(p) {
    true => load_directory(acc, p),
    false => match fs.read_text(p) {
      Ok(text) => with_document(acc, p, text),
      Err(e) => with_error(acc, p, fs_reason(e)),
    },
  }
}

// A directory contributes its markdown files and its subdirectories. The entries
// are sorted because `fs.read_dir` returns them in whatever order the OS gives,
// and a report whose rows move between machines cannot be diffed.
fn load_directory(acc: Loaded, dir: string) -> Loaded {
  return match fs.read_dir(dir) {
    Err(e) => with_error(acc, dir, fs_reason(e)),
    Ok(entries) => {
      let out = acc
      for entry in array.sort(entries, compare_text) {
        mut out = load_entry(out, path.join([dir, entry]))
      }
      out
    },
  }
}

// Markdown files are collected; a subdirectory is walked; anything else is left
// alone.
fn load_entry(acc: Loaded, p: string) -> Loaded {
  return match fs.is_dir(p) {
    true => load_directory(acc, p),
    false => match string.ends_with(string.lower(p), ".md") {
      true => load_one(acc, p),
      false => acc,
    },
  }
}

// Why an fs call failed, named by kind. Each arm is a variant of `fs.ErrorKind`,
// so the reason is recovered from the error's own vocabulary instead of from an
// errno string. The `else` arm covers `Other({ code })` and is required: Glyph
// does not yet check a `match e.kind` for exhaustiveness, so an omitted kind
// would be a run-time throw rather than an E0200.
fn fs_reason(e: fs.FsError) -> string {
  return match e.kind {
    fs.ErrorKind.NotFound => "no such file or directory",
    fs.ErrorKind.PermissionDenied => "permission denied",
    fs.ErrorKind.IsADirectory => "is a directory",
    fs.ErrorKind.NotADirectory => "not a directory",
    fs.ErrorKind.AlreadyExists => "already exists",
    else => e.message,
  }
}

fn with_document(acc: Loaded, p: string, text: string) -> Loaded {
  return { documents: array.push(acc.documents, { path: p, text: text }), errors: acc.errors }
}

fn with_error(acc: Loaded, p: string, message: string) -> Loaded {
  return { documents: acc.documents, errors: array.push(acc.errors, { path: p, message: message }) }
}

fn links_of(doc: Document) -> Array<Link> {
  return array.map(
    extract(doc.text),
    fn(raw: RawLink) -> Link {
      return {
        file: doc.path,
        line: raw.line,
        target: raw.target,
        is_image: raw.is_image,
        kind: classify(raw.target),
      }
    },
  )
}

// ---------------------------------------------------------------------------
// Checking
// ---------------------------------------------------------------------------

type Fetched = { url: string, outcome: Outcome }

fn external_url(link: Link) -> Option<string> {
  return match link.kind {
    External({ url }) => Some(url),
    RelativeFile({ target, anchor }) => None,
    InPageAnchor({ slug }) => None,
    OtherScheme({ scheme }) => None,
    Malformed({ reason }) => None,
  }
}

// Every distinct external URL across every file, in first-seen order.
fn unique_external(links: Array<Link>) -> Array<string> {
  let seen = set.create<string>()
  let urls: Array<string> = []
  for link in links {
    mut urls = match external_url(link) {
      None => urls,
      Some(url) => match seen.has(url) {
        true => urls,
        false => {
          seen.add(url)
          array.push(urls, url)
        },
      },
    }
  }
  return urls
}

// No return annotation: a Glyph function type cannot spell an async thunk, and
// `-> fn() -> Fetched` emits `() => Fetched`, which the async body does not fit.
fn task_for(url: string) {
  return async fn() -> Fetched { return { url: url, outcome: await check_external(url) } }
}

// `pool_settled`, not `pool`: `pool` is fail-fast, so one thunk that throws
// discards every other URL's answer along with it. Here a throw costs exactly
// one URL, and that URL says what went wrong instead of the run dying.
async fn fetch_unique(urls: Array<string>, limit: int) -> Record<string, Outcome> {
  let settled = await task.pool_settled(limit, array.map(urls, task_for))
  let cache: Record<string, Outcome> = {}
  let i = 0
  for s in settled {
    mut cache = record.set(cache, urls[i], settled_outcome(s))
    mut i = i + 1
  }
  return cache
}

// `pool_settled` keeps the order it was given, so the nth outcome belongs to the
// nth URL. A task that threw is a network failure like any other.
fn settled_outcome(s: task.Settled<Fetched>) -> Outcome {
  return match s.ok {
    true => s.value.outcome,
    false => NetworkFail({ message: first_line(string.from(s.error)) }),
  }
}

fn check_links(
  links: Array<Link>,
  docs: Record<string, string>,
  cache: Record<string, Outcome>,
  offline: bool,
) -> Array<Checked> {
  let out: Array<Checked> = []
  let served = set.create<string>()
  for link in links {
    // The first occurrence of a URL is the one that paid for the fetch; every
    // later occurrence is served from the shared answer.
    let from_cache = match external_url(link) {
      None => false,
      Some(url) => {
        let seen = served.has(url)
        served.add(url)
        seen
      },
    }
    mut out = array.push(
      out,
      { link: link, outcome: outcome_for(link, docs, cache, offline), cached: from_cache },
    )
  }
  return out
}

fn outcome_for(
  link: Link,
  docs: Record<string, string>,
  cache: Record<string, Outcome>,
  offline: bool,
) -> Outcome {
  return match link.kind {
    Malformed({ reason }) => Bad({ reason: reason }),
    OtherScheme({ scheme }) => Skipped({ reason: "${scheme}: not checked" }),
    InPageAnchor({ slug }) => match record.get(docs, link.file) {
      Some(text) => check_in_page(text, slug, link.file),
      None => Bad({ reason: "source document went missing" }),
    },
    RelativeFile({ target, anchor }) => check_relative(link.file, target, anchor),
    External({ url }) => match offline {
      true => Skipped({ reason: "offline" }),
      false => match record.get(cache, url) {
        Some(outcome) => outcome,
        None => Bad({ reason: "no result for ${url}" }),
      },
    },
  }
}

// ---------------------------------------------------------------------------
// Report
// ---------------------------------------------------------------------------

fn tally_of(rows: Array<Checked>) -> Tally {
  let empty: Tally = { checked: 0, ok: 0, broken: 0, skipped: 0, cached: 0 }
  return array.fold(
    rows,
    empty,
    fn(t: Tally, row: Checked) -> Tally {
      return {
        checked: t.checked + 1,
        ok: t.ok + match is_broken(row.outcome) || is_skipped(row.outcome) {
          true => 0,
          false => 1,
        },
        broken: t.broken + match is_broken(row.outcome) {
          true => 1,
          false => 0,
        },
        skipped: t.skipped + match is_skipped(row.outcome) {
          true => 1,
          false => 0,
        },
        cached: t.cached + match row.cached {
          true => 1,
          false => 0,
        },
      }
    },
  )
}

fn tally_line(t: Tally) -> string {
  let parts = [
    "${number.to_string(t.checked)} checked",
    "${number.to_string(t.ok)} ok",
    "${number.to_string(t.broken)} broken",
    "${number.to_string(t.skipped)} skipped",
    "${number.to_string(t.cached)} cached",
  ]
  return string.join(parts, ", ")
}

// An image source is shown with markdown's own `!` marker so the report says
// what kind of link it is without a second column.
fn shown_target(link: Link) -> string {
  return match link.is_image {
    true => "!${link.target}",
    false => link.target,
  }
}

fn render_file(file: string, rows: Array<Checked>) -> Array<string> {
  let locs = array.map(rows, fn(r: Checked) -> string { return number.to_string(r.link.line) })
  let tags = array.map(rows, fn(r: Checked) -> string { return status_tag(r.outcome) })
  let targets = array.map(rows, fn(r: Checked) -> string { return shown_target(r.link) })
  let loc_w = widest(locs)
  let tag_w = widest(tags)
  let target_w = widest(targets)
  let lines: Array<string> = ["${file}"]
  for row in rows {
    let loc = string.pad_start(number.to_string(row.link.line), loc_w)
    let tag = string.pad_end(status_tag(row.outcome), tag_w)
    let detail = status_detail(row.outcome)
    let note = match row.cached {
      true => " (cached)",
      false => EMPTY,
    }
    let tail = "${detail}${note}"
    // A row with no detail would end in the target column's padding, so the
    // whole line is right-trimmed.
    let target = string.pad_end(shown_target(row.link), target_w)
    let body = string.trim_end("${loc}  ${tag}  ${target}  ${tail}")
    mut lines = array.push(lines, "  ${body}")
  }
  mut lines = array.push(lines, "  ${tally_line(tally_of(rows))}")
  return lines
}

// ---------------------------------------------------------------------------
// Arguments
// ---------------------------------------------------------------------------

const DEFAULT_CONCURRENCY = 8

fn parse_args(argv: Array<string>) -> Result<Args, ArgError> {
  let paths: Array<string> = []
  let offline = false
  let limit = DEFAULT_CONCURRENCY
  let failure: Option<ArgError> = None
  let i = 0
  let n = array.len(argv)
  loop {
    match i < n && failure == None {
      false => { break },
      true => {
        let arg = argv[i]
        let split: Array<string> = string.split(arg, "=")
        let name = string.join(array.slice(split, 0, 1), EMPTY)
        let inline_value = string.join(array.slice(split, 1, array.len(split)), "=")
        match name {
          "--offline" => {
            mut offline = true
            mut i = i + 1
          },
          "--max-concurrency" => {
            let uses_inline = array.len(split) > 1
            let value = match uses_inline {
              true => inline_value,
              false => match i + 1 < n {
                true => argv[i + 1],
                false => EMPTY,
              },
            }
            match value == EMPTY {
              true => { mut failure = Some(MissingValue({ flag: name })) },
              false => {
                match number.parse(value) {
                  Ok(v) => { mut limit = math.max(1, v) },
                  Err(_) => { mut failure = Some(BadNumber({ flag: name, value: value })) },
                }
                mut i = match uses_inline {
                  true => i + 1,
                  false => i + 2,
                }
              },
            }
          },
          else => {
            match string.starts_with(arg, "--") {
              true => { mut failure = Some(UnknownFlag({ flag: arg })) },
              false => {
                mut paths = array.push(paths, arg)
                mut i = i + 1
              },
            }
          },
        }
      },
    }
  }
  return match failure {
    Some(e) => Err(e),
    None => match array.len(paths) == 0 {
      true => Err(NoPaths),
      false => Ok({ paths: paths, offline: offline, max_concurrency: limit }),
    },
  }
}

fn arg_error_message(e: ArgError) -> string {
  return match e {
    NoPaths => "usage: linkcheck <file.md | dir> [more...] [--offline] [--max-concurrency N]",
    MissingValue({ flag }) => "${flag} needs a value",
    BadNumber({ flag, value }) => "${flag}: not a number: ${value}",
    UnknownFlag({ flag }) => "unknown flag: ${flag}",
  }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

async fn main(argv: Array<string>) -> number {
  return match parse_args(process.args()) {
    Err(e) => {
      io.eprintln(arg_error_message(e))
      2
    },
    Ok(args) => await run(args),
  }
}

async fn run(args: Args) -> number {
  let loaded = load_all(args.paths)
  for fe in loaded.errors {
    io.eprintln("${fe.path}: ${fe.message}")
  }

  let no_docs: Record<string, string> = {}
  let docs = array.fold(
    loaded.documents,
    no_docs,
    fn(acc: Record<string, string>, doc: Document) -> Record<string, string> {
      return record.set(acc, doc.path, doc.text)
    },
  )
  let all_links = array.flat_map(loaded.documents, links_of)

  let cache = match args.offline {
    true => ({}),
    false => await fetch_unique(unique_external(all_links), args.max_concurrency),
  }

  let rows = check_links(all_links, docs, cache, args.offline)

  for doc in loaded.documents {
    let file_rows = array.filter(rows, fn(r: Checked) -> bool { return r.link.file == doc.path })
    match array.len(file_rows) == 0 {
      true => {},
      false => {
        for line in render_file(doc.path, file_rows) {
          io.println(line)
        }
        io.println(EMPTY)
      },
    }
  }

  let total = tally_of(rows)
  io.println("total: ${tally_line(total)}")
  match array.len(loaded.errors) > 0 {
    true => io.println("unreadable files: ${number.to_string(array.len(loaded.errors))}"),
    false => {},
  }

  return match total.broken > 0 || array.len(loaded.errors) > 0 {
    true => 1,
    false => 0,
  }
}

// ---------------------------------------------------------------------------
// Inline tests over the pure parts
// ---------------------------------------------------------------------------

const SAMPLE_MD = "# Title\n\nSee [docs](./docs.md) and <https://example.com>.\n\n```\n[not a link](nope.md)\n```\n\n[ref]: https://ref.example.com\n\nInline `[code](x.md)` stays put.\n\n![img](./logo.png)\n"

fn raw_summary(r: RawLink) -> string {
  return "${number.to_string(r.line)}:${r.target}"
}

fn extract_summary(text: string) -> string {
  return string.join(array.map(extract(text), raw_summary), ";")
}

@example extract_summary(SAMPLE_MD) == "3:./docs.md;3:https://example.com;9:https://ref.example.com;13:./logo.png"
@example string.join(heading_slugs(SAMPLE_MD), ",") == "title"
fn tests_anchor() -> bool {
  return true
}
