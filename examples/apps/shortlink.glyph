// shortlink — a URL shortener you can point a browser at, with no extern shim.
//
// POST a long URL from an HTML form, get back a base62 short code. GET the code
// and the browser is redirected (302 + Location) to the target; the click is
// counted. GET the code with a trailing `+` for a stats page. Everything is
// server-rendered HTML, escaped, and the link table survives a restart.
//
// Run it:  glyph run examples/apps/shortlink.glyph
// Then:
//   curl -i -X POST localhost:8138/ --data-urlencode 'url=https://example.com/x'
//   curl -i localhost:8138/<code>
//   curl localhost:8138/<code>+
//   open http://localhost:8138/
//
// This version imports no `extern/*` shim and no Node builtin. std/http carries
// the whole wire: `serve` runs the server, `html` sends a page, `redirect` sets
// a `Location`, and `form` reads an HTML form POST. A handler returns
// `Result<Response, string>`, so a 404 is a normal `Ok` and only a real failure
// is an `Err`.
//
// One thing std/http still does not have and this file builds by hand: percent
// encoding, needed to put an error message into a query string.

module main

import std/array
import std/encoding
import std/fs
import std/http { Request, Response, serve, html, redirect, form, path, segments, query_param }
import std/io { println }
import std/json
import std/option { Option, Some, None }
import std/random { seeded }
import std/record
import std/regex
import std/result { Result, Ok, Err }
import std/store { create }
import std/string
import std/time

// ---------------------------------------------------------------------------
// Percent encoding, not in std
// ---------------------------------------------------------------------------

fn is_hex_pair(s: string) -> bool {
  return regex.matches("^[0-9A-Fa-f][0-9A-Fa-f]$", s)
}

// Percent-escapes decode to *bytes*, and consecutive escapes are one UTF-8
// sequence, so they are buffered and handed to `encoding.hex_decode` together.
fn flush_hex(pending: string) -> string {
  return match string.len(pending) == 0 {
    true => "",
    false => encoding.hex_decode(pending),
  }
}

fn percent_decode(input: string) -> string {
  let parts = string.split(input, "%")
  let out = parts[0]
  let pending = ""
  for part in array.slice(parts, 1) {
    let head = string.slice(part, 0, 2)
    let tail = string.slice(part, 2)
    match is_hex_pair(head) {
      true => {
        mut pending = "${pending}${head}"
        match string.len(tail) == 0 {
          true => {},
          false => {
            mut out = "${out}${flush_hex(pending)}${tail}"
            mut pending = ""
          },
        }
      },
      // A stray `%` is not an escape; keep it as typed.
      false => {
        mut out = "${out}${flush_hex(pending)}%${part}"
        mut pending = ""
      },
    }
  }
  return "${out}${flush_hex(pending)}"
}

// The lead nibbles of a byte below 0x80.
const ASCII_LEAD = "01234567"

fn encode_byte(pair: string, keep: string) -> string {
  return match string.contains(ASCII_LEAD, string.slice(pair, 0, 1)) {
    // A continuation byte of a multi-byte character is never a literal.
    false => "%${pair}",
    true => {
      let ch = encoding.hex_decode(pair)
      match regex.matches(keep, ch) {
        true => ch,
        false => "%${pair}",
      }
    },
  }
}

// Percent-encoding works on *bytes*, so the input is turned into hex once and
// sliced two digits at a time. Doing it per character instead looks right and
// is wrong: slicing by one splits by UTF-16 unit, so `🎉` arrives as two lone
// surrogates and encodes to `%EF%BF%BD%EF%BF%BD`. There is no codepoint-aware
// iteration in std/string.
fn encode_bytes(input: string, keep: string) -> string {
  let hex = string.upper(encoding.hex_encode(input))
  let n = string.len(hex)
  let out = ""
  let i = 0
  loop {
    match i >= n {
      true => { return out },
      false => {},
    }
    mut out = "${out}${encode_byte(string.slice(hex, i, i + 2), keep)}"
    mut i = i + 2
  }
}

// What `encodeURIComponent` is in JavaScript: everything outside the unreserved
// set becomes an escape, so the result is safe as a query-string value.
fn url_encode(input: string) -> string {
  return encode_bytes(input, "^[A-Za-z0-9._~-]$")
}

// ---------------------------------------------------------------------------
// Form fields
// ---------------------------------------------------------------------------

fn form_field(fields: Record<string, string>, name: string) -> string {
  return match record.get(fields, name) {
    Some(value) => value,
    None => "",
  }
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

type Link = { code: string, target: string, created_at: int, clicks: int }

// The on-disk shape. A record (not a bare array) so `Snapshot.parse` validates
// the whole file at the boundary where untrusted bytes come back in.
type Snapshot = { links: Array<Link> }

const DB_PATH = "shortlink.json"

const PORT = 8138

const ALPHABET = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

const MAX_ATTEMPTS = 16

const MAX_ALIAS_LEN = 32

// The one piece of shared mutable state. Every change is a greppable
// `links.set(...)` / `links.update(...)`.
const links = create<Array<Link>>([])

const rng = seeded(time.now())

// ---------------------------------------------------------------------------
// Persistence
// ---------------------------------------------------------------------------

fn load_links(from_path: string) -> Array<Link> {
  return match fs.read_text(from_path) {
    Ok(text) => match json.parse<Snapshot>(text) {
      Ok(snapshot) => snapshot.links,
      Err(issues) => [],
    },
    Err(e) => [],
  }
}

fn save_links(to_path: string, current: Array<Link>) -> Result<void, string> {
  let snapshot: Snapshot = { links: current }
  return match fs.write_text(to_path, json.stringify(snapshot, { indent: 2 })) {
    Ok(nothing) => Ok(nothing),
    Err(e) => Err(e.message),
  }
}

// ---------------------------------------------------------------------------
// Codes
// ---------------------------------------------------------------------------

fn random_code() -> string {
  // No range syntax, so a fixed-length loop is a literal array of indices.
  return array.fold(
    [0, 1, 2, 3, 4, 5, 6],
    "",
    fn(out: string, _i: int) -> string {
      let pick = rng.int(0, 62)
      return "${out}${string.slice(ALPHABET, pick, pick + 1)}"
    },
  )
}

fn find_link(current: Array<Link>, code: string) -> Option<Link> {
  return array.find(current, fn(l: Link) -> bool { l.code == code })
}

fn is_taken(current: Array<Link>, code: string) -> bool {
  return match find_link(current, code) {
    Some(existing) => true,
    None => false,
  }
}

// Collision-checked: keep drawing until the code is free, and give up rather
// than loop forever.
fn fresh_code(current: Array<Link>) -> Result<string, string> {
  let attempts = 0
  loop {
    let candidate = random_code()
    match is_taken(current, candidate) {
      false => { return Ok(candidate) },
      true => {},
    }
    mut attempts = attempts + 1
    match attempts >= MAX_ATTEMPTS {
      true => { return Err("Could not find a free code. Try again.") },
      false => {},
    }
  }
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

// The host of an absolute http(s) URL, or "" when there isn't one.
fn host_of(url: string) -> string {
  let after_scheme = string.split(url, "://")
  return match array.len(after_scheme) < 2 {
    true => "",
    false => {
      let authority = string.split(after_scheme[1], "/")
      let no_query = string.split(authority[0], "?")
      let no_hash = string.split(no_query[0], "#")
      no_hash[0]
    },
  }
}

// A submitted URL is never stored until it passes here.
fn validate_url(input: string) -> Result<string, string> {
  let url = string.trim(input)
  return match string.len(url) == 0 {
    true => Err("Enter a URL."),
    false => match string.starts_with(url, "http://") || string.starts_with(url, "https://") {
      false => Err("URL must start with http:// or https://."),
      true => match string.len(host_of(url)) == 0 {
        true => Err("URL has no host."),
        false => Ok(url),
      },
    },
  }
}

fn is_base62(s: string) -> bool {
  return regex.matches("^[0-9A-Za-z]+$", s)
}

fn validate_alias(current: Array<Link>, alias: string) -> Result<Option<string>, string> {
  let candidate = string.trim(alias)
  return match string.len(candidate) == 0 {
    true => Ok(None),
    false => match is_base62(candidate) {
      false => Err("Alias may only contain letters and digits."),
      true => match string.len(candidate) > MAX_ALIAS_LEN {
        true => Err("Alias is too long."),
        false => match is_taken(current, candidate) {
          true => Err("That alias is already taken."),
          false => Ok(Some(candidate)),
        },
      },
    },
  }
}

// ---------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------

// Every untrusted value goes through here before it reaches the page.
fn escape_html(s: string) -> string {
  let amp = string.replace_all(s, "&", "&amp;")
  let lt = string.replace_all(amp, "<", "&lt;")
  let gt = string.replace_all(lt, ">", "&gt;")
  let quot = string.replace_all(gt, "\"", "&quot;")
  return string.replace_all(quot, "'", "&#39;")
}

const STYLE = "
body { font: 15px/1.5 system-ui, sans-serif; margin: 3rem auto; max-width: 46rem; padding: 0 1rem; }
h1 { font-size: 1.4rem; }
form { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0; }
input { flex: 1 1 14rem; padding: .5rem; font: inherit; border: 1px solid #bbb; border-radius: 4px; }
button { padding: .5rem 1rem; font: inherit; cursor: pointer; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #eee; }
.error { background: #fdeaea; border: 1px solid #e8a0a0; padding: .6rem .8rem; border-radius: 4px; }
.empty { color: #777; }
code { font-family: ui-monospace, monospace; }
"

fn page(title: string, body: string) -> string {
  return "<!doctype html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>${escape_html(title)}</title>
<style>${STYLE}</style>
</head>
<body>
${body}
</body>
</html>
"
}

fn error_banner(message: Option<string>) -> string {
  return match message {
    Some(text) => "<p class='error'>${escape_html(text)}</p>",
    None => "",
  }
}

fn row(l: Link) -> string {
  let code = escape_html(l.code)
  let target = escape_html(l.target)
  let clicks = number.to_string(l.clicks)
  let created = escape_html(time.format_iso(l.created_at))
  return "<tr><td><a href='/${code}'><code>${code}</code></a></td><td><a href='${target}'>${target}</a></td><td>${clicks}</td><td>${created}</td><td><a href='/${code}+'>stats</a></td></tr>"
}

fn table(current: Array<Link>) -> string {
  return match array.len(current) == 0 {
    true => "<p class='empty'>No links yet.</p>",
    false => {
      let rows: Array<string> = array.map(array.reverse(current), row)
      let joined = string.join(rows, "\n")
      "<table><thead><tr><th>Code</th><th>Target</th><th>Clicks</th><th>Created</th><th></th></tr></thead><tbody>
${joined}
</tbody></table>"
    },
  }
}

fn home_page(current: Array<Link>, error: Option<string>) -> string {
  let body = "<h1>shortlink</h1>
${error_banner(error)}
<form method='post' action='/'>
<input name='url' placeholder='https://example.com/a-long-path' autofocus>
<input name='alias' placeholder='custom alias (optional)'>
<button type='submit'>Shorten</button>
</form>
${table(current)}
"
  return page("shortlink", body)
}

fn stats_page(l: Link) -> string {
  let code = escape_html(l.code)
  let target = escape_html(l.target)
  let body = "<h1>/${code}</h1>
<table><tbody>
<tr><th>Code</th><td><code>${code}</code></td></tr>
<tr><th>Target</th><td><a href='${target}'>${target}</a></td></tr>
<tr><th>Created</th><td>${escape_html(time.format_iso(l.created_at))}</td></tr>
<tr><th>Clicks</th><td>${number.to_string(l.clicks)}</td></tr>
</tbody></table>
<p><a href='/'>&larr; all links</a></p>
"
  return page("shortlink /${l.code}", body)
}

fn not_found_page(what: string) -> string {
  let body = "<h1>404</h1>
<p>No link with the code <code>${escape_html(what)}</code>.</p>
<p><a href='/'>&larr; all links</a></p>
"
  return page("404", body)
}

// ---------------------------------------------------------------------------
// Actions
// ---------------------------------------------------------------------------

fn create_link(url_input: string, alias_input: string) -> Result<Link, string> {
  let current = links.get()
  let target = validate_url(url_input)?
  let alias = validate_alias(current, alias_input)?
  // `?` is rejected in a match-arm value position (E0300), so the Result is
  // built first and unwrapped on its own line.
  let chosen = match alias {
    Some(a) => Ok(a),
    None => fresh_code(current),
  }
  let code = chosen?
  let link: Link = { code: code, target: target, created_at: time.now(), clicks: 0 }
  links.set(array.push(current, link))
  save_links(DB_PATH, links.get())?
  return Ok(link)
}

fn count_click(code: string) -> void {
  links.update(
    fn(current: Array<Link>) -> Array<Link> {
      return array.map(
        current,
        fn(l: Link) -> Link {
          return match l.code == code {
            true => {
              code: l.code,
              target: l.target,
              created_at: l.created_at,
              clicks: l.clicks + 1,
            },
            false => l,
          }
        },
      )
    },
  )
  let _saved = save_links(DB_PATH, links.get())
}

// ---------------------------------------------------------------------------
// Routing
// ---------------------------------------------------------------------------

// `/abc+` is the stats page for `/abc`.
fn stats_code(segment: string) -> Option<string> {
  return match string.ends_with(segment, "+") {
    false => None,
    true => {
      let head = string.split(segment, "+")
      match string.len(head[0]) == 0 {
        true => None,
        false => Some(head[0]),
      }
    },
  }
}

fn handle_home(req: Request) -> Response {
  return match req.method {
    "GET" => html(200, home_page(links.get(), query_param(req, "error"))),
    // Post/redirect/get: a submit always answers with a redirect, so a browser
    // reload never re-posts the form. The error, if any, rides back in the
    // query string, which is why this app needs percent-encoding as well as
    // decoding.
    "POST" => {
      let fields = form(req)
      match create_link(form_field(fields, "url"), form_field(fields, "alias")) {
        Ok(link) => redirect(303, "/${link.code}+"),
        Err(message) => redirect(303, "/?error=${url_encode(message)}"),
      }
    },
    else => html(405, page("405", "<h1>405</h1><p>Method not allowed.</p>")),
  }
}

fn handle_code(code: string) -> Response {
  return match find_link(links.get(), code) {
    Some(link) => {
      count_click(link.code)
      redirect(302, link.target)
    },
    None => html(404, not_found_page(code)),
  }
}

fn handle_stats(code: string) -> Response {
  return match find_link(links.get(), code) {
    Some(link) => html(200, stats_page(link)),
    None => html(404, not_found_page(code)),
  }
}

// std/http's `Handler` returns `Result<Response, string>`: every status a user
// can reach is an `Ok`, and an `Err` is reserved for a failure the app cannot
// answer, which the server turns into a 500.
fn route(req: Request) -> Result<Response, string> {
  return match segments(req) {
    [] => Ok(handle_home(req)),
    [one] => match stats_code(percent_decode(one)) {
      Some(code) => Ok(handle_stats(code)),
      None => Ok(handle_code(percent_decode(one))),
    },
    else => Ok(html(404, not_found_page(path(req)))),
  }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

async fn main(argv: Array<string>) -> number {
  links.set(load_links(DB_PATH))
  println("shortlink listening on http://localhost:${number.to_string(PORT)}")
  println("  ${number.to_string(array.len(links.get()))} link(s) loaded from ${DB_PATH}")
  // `serve` stays pending while the server listens, so this keeps the process
  // alive on its own, and a bind failure comes back as a value to match on.
  let outcome = await serve(PORT, route)
  return match outcome {
    Ok(nothing) => 0,
    Err(message) => {
      println("shortlink: ${message}")
      1
    },
  }
}
