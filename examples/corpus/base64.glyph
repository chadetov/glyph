// Pure-Glyph Base64 codec (RFC 4648) over byte arrays. std/encoding wraps the
// platform `Buffer` for this; here the whole transform is Glyph: 6-bit
// grouping via integer arithmetic, alphabet lookup by string indexing, padding
// with `=`, and a decode that returns an Option so malformed input is a value,
// not an exception. The only platform leaves are math.floor and the len
// accessors; there is no bit-twiddling primitive, so 24-bit triples are built
// and split with `*`, `/`, and `%`.
module base64

import std/math
import std/array
import std/string
import std/option { Option, Some, None }

// The 64 Base64 digits, index i -> character. Position in this string IS the
// 6-bit value, so it doubles as the decode table.
fn alphabet() -> string {
  return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

// The 6-bit value `v` (0..63) as its Base64 character.
fn enc_digit(v: number) -> string {
  return alphabet()[v]
}

// Value of a Base64 character, or None if it is not in the alphabet. A linear
// scan of the table; `i` walks the 64 positions.
fn dec_scan(ch: string, i: number) -> Option<number> {
  let table = alphabet()
  return match i >= string.len(table) {
    true => None,
    false => match table[i] == ch {
      true => Some(i),
      false => dec_scan(ch, i + 1),
    },
  }
}

fn dec_digit(ch: string) -> Option<number> {
  return dec_scan(ch, 0)
}

// Byte at index `i`, or 0 when past the end. Lets the encoder read a partial
// final group without a bounds branch at every access.
fn byte_or_zero(bytes: Array<number>, i: number) -> number {
  return match i >= array.len(bytes) {
    true => 0,
    false => bytes[i],
  }
}

// Encode one 3-byte group starting at `i`. `remaining` is how many real bytes
// are left (1, 2, or 3+); it decides how many digits and pad chars to emit.
fn encode_group(bytes: Array<number>, i: number, remaining: number) -> string {
  let b0 = bytes[i]
  let b1 = byte_or_zero(bytes, i + 1)
  let b2 = byte_or_zero(bytes, i + 2)
  let triple = b0 * 65536 + b1 * 256 + b2
  let g0 = math.floor(triple / 262144) % 64
  let g1 = math.floor(triple / 4096) % 64
  let g2 = math.floor(triple / 64) % 64
  let g3 = triple % 64
  return match remaining == 1 {
    true => enc_digit(g0) + enc_digit(g1) + "==",
    false => match remaining == 2 {
      true => enc_digit(g0) + enc_digit(g1) + enc_digit(g2) + "=",
      false => enc_digit(g0) + enc_digit(g1) + enc_digit(g2) + enc_digit(g3),
    },
  }
}

fn encode_from(bytes: Array<number>, i: number) -> string {
  let n = array.len(bytes)
  return match i >= n {
    true => "",
    false => encode_group(bytes, i, n - i) + encode_from(bytes, i + 3),
  }
}

// Encode a byte array (each element a 0..255 octet) to a Base64 string.
pub fn encode(bytes: Array<number>) -> string {
  return encode_from(bytes, 0)
}

// Decode a 4-character group to its 1..3 bytes, or None if any non-pad
// character is outside the alphabet. `=` is only honored in the trailing two
// positions; the byte count follows the padding.
fn decode_group(c0: string, c1: string, c2: string, c3: string) -> Option<Array<number>> {
  return match dec_digit(c0) {
    None => None,
    Some(v0) => match dec_digit(c1) {
      None => None,
      Some(v1) => match c2 == "=" {
        true => {
          let triple = v0 * 262144 + v1 * 4096
          return Some([math.floor(triple / 65536) % 256])
        },
        false => match dec_digit(c2) {
          None => None,
          Some(v2) => match c3 == "=" {
            true => {
              let triple = v0 * 262144 + v1 * 4096 + v2 * 64
              return Some([
                math.floor(triple / 65536) % 256,
                math.floor(triple / 256) % 256,
              ])
            },
            false => match dec_digit(c3) {
              None => None,
              Some(v3) => {
                let triple = v0 * 262144 + v1 * 4096 + v2 * 64 + v3
                return Some([
                  math.floor(triple / 65536) % 256,
                  math.floor(triple / 256) % 256,
                  triple % 256,
                ])
              },
            },
          },
        },
      },
    },
  }
}

fn decode_from(text: string, i: number) -> Option<Array<number>> {
  return match i >= string.len(text) {
    true => Some([]),
    false => match decode_group(text[i], text[i + 1], text[i + 2], text[i + 3]) {
      None => None,
      Some(head) => match decode_from(text, i + 4) {
        None => None,
        Some(tail) => Some(array.concat(head, tail)),
      },
    },
  }
}

// Decode a Base64 string to its bytes. Length must be a multiple of 4 (canonical
// padded Base64); anything else, or a stray character, yields None.
pub fn decode(text: string) -> Option<Array<number>> {
  return match string.len(text) % 4 == 0 {
    true => decode_from(text, 0),
    false => None,
  }
}
