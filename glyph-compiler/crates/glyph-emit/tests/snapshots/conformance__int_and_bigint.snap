import "./.glyph-runtime/glyph-bootstrap";

import { Ok as __glyph_ok, Err as __glyph_err, type Result as __GlyphResult } from "./.glyph-runtime/std/result";

import { schema as __glyph_schema } from "./.glyph-runtime/std/schema";

export type Account = { id: bigint; balance: number };
export const Account = {
  is(value: unknown): value is Account {
    return typeof value === "object" && value !== null && !Array.isArray(value)
      && typeof (value as Record<string, unknown>).id === "bigint"
      && (typeof (value as Record<string, unknown>).balance === "number" && Number.isInteger((value as Record<string, unknown>).balance))
      && Object.keys(value as object).every((__k: string) => __k === "id" || __k === "balance");
  },
  parse(value: unknown): __GlyphResult<Account, Issue[]> {
    if (Array.isArray(value)) {
      return __glyph_err([{ path: [], message: "expected Account (an object), got an array", code: "type" }]);
    }
    if (typeof value !== "object" || value === null) {
      return __glyph_err([{ path: [], message: "expected Account (an object)", code: "type" }]);
    }
    const __issues: Issue[] = [];
    if ((value as Record<string, unknown>).id === undefined) {
      __issues.push({ path: ["id"], message: "field `id` is required", code: "missing" });
    } else if (!(typeof (value as Record<string, unknown>).id === "bigint")) {
      __issues.push({ path: ["id"], message: "field `id` must be bigint", code: "type" });
    }
    if ((value as Record<string, unknown>).balance === undefined) {
      __issues.push({ path: ["balance"], message: "field `balance` is required", code: "missing" });
    } else if (!((typeof (value as Record<string, unknown>).balance === "number" && Number.isInteger((value as Record<string, unknown>).balance)))) {
      __issues.push({ path: ["balance"], message: "field `balance` must be int", code: "type" });
    }
    for (const __k of Object.keys(value as object)) {
      if (!(__k === "id" || __k === "balance")) __issues.push({ path: [__k], message: "unexpected field `" + __k + "`", code: "unexpected" });
    }
    return __issues.length === 0 ? __glyph_ok(value as Account) : __glyph_err(__issues);
  },
  schema: __glyph_schema<Account>("Account", (v): v is Account => Account.is(v), (v: unknown): __GlyphResult<Account, Issue[]> => Account.parse(v)),
};

export function next_id(cur: bigint): bigint {
  return (cur + 1n);
}
