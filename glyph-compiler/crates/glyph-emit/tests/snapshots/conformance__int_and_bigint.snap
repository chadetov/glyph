import "./.glyph-runtime/glyph-bootstrap";

import { schema as __glyph_schema } from "std/schema";

export type Account = { id: bigint; balance: number };
export const Account = {
  is(value: unknown): value is Account {
    return typeof value === "object" && value !== null
      && typeof (value as Record<string, unknown>).id === "bigint"
      && (typeof (value as Record<string, unknown>).balance === "number" && Number.isInteger((value as Record<string, unknown>).balance))
      && Object.keys(value as object).every((__k: string) => __k === "id" || __k === "balance");
  },
  parse(value: unknown): { tag: "Ok"; value: Account } | { tag: "Err"; value: string } {
    return this.is(value)
      ? { tag: "Ok", value: value }
      : { tag: "Err", value: "expected Account" };
  },
  schema: __glyph_schema<Account>("Account", (v): v is Account => Account.is(v)),
};

export function next_id(cur: bigint): bigint {
  return (cur + 1n);
}
