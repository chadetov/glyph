    }
    if (typeof value !== "object" || value === null) {
      return __glyph_err([{ path: [], message: "expected Event (an object)", code: "type" }]);
    }
    const __issues: Issue[] = [];
    if ((value as Record<string, unknown>).type === undefined) {
