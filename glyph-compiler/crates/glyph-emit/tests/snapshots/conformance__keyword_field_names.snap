export type Note = { match: string };
export const Note = {
  is(value: unknown): value is Note {
    return typeof value === "object" && value !== null && !Array.isArray(value)
      && typeof (value as Record<string, unknown>).match === "string"
      && Object.keys(value as object).every((__k: string) => __k === "match");
  },
