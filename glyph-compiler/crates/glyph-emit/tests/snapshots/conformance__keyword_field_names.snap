export type Event = { type: "open" | "close"; is: boolean; id: number };
export const Event = {
  is(value: unknown): value is Event {
    return typeof value === "object" && value !== null && !Array.isArray(value)
      && ((value as Record<string, unknown>).type === "open" || (value as Record<string, unknown>).type === "close")
      && typeof (value as Record<string, unknown>).is === "boolean"
      && typeof (value as Record<string, unknown>).id === "number"
      && Object.keys(value as object).every((__k: string) => __k === "type" || __k === "is" || __k === "id");
  },
  parse(value: unknown): __GlyphResult<Event, Issue[]> {
