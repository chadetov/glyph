import "./.glyph-runtime/glyph-bootstrap";

import { Ok as __glyph_ok, Err as __glyph_err, type Result as __GlyphResult } from "std/result";

import { schema as __glyph_schema } from "std/schema";

export type Tier = "free" | "pro";

export type Plan = { tier: Tier };
export const Plan = {
  is(value: unknown): value is Plan {
    return typeof value === "object" && value !== null && !Array.isArray(value)
      && ((value as Record<string, unknown>).tier === "free" || (value as Record<string, unknown>).tier === "pro")
      && Object.keys(value as object).every((__k: string) => __k === "tier");
  },
  parse(value: unknown): __GlyphResult<Plan, Issue[]> {
    if (Array.isArray(value)) {
      return __glyph_err([{ path: [], message: "expected Plan (an object), got an array", code: "type" }]);
    }
    if (typeof value !== "object" || value === null) {
      return __glyph_err([{ path: [], message: "expected Plan (an object)", code: "type" }]);
    }
    const __issues: Issue[] = [];
    if ((value as Record<string, unknown>).tier === undefined) {
      __issues.push({ path: ["tier"], message: "field `tier` is required", code: "missing" });
    } else if (!(((value as Record<string, unknown>).tier === "free" || (value as Record<string, unknown>).tier === "pro"))) {
      __issues.push({ path: ["tier"], message: "field `tier` must be Tier", code: "type" });
    }
    for (const __k of Object.keys(value as object)) {
      if (!(__k === "tier")) __issues.push({ path: [__k], message: "unexpected field `" + __k + "`", code: "unexpected" });
    }
    return __issues.length === 0 ? __glyph_ok(value as Plan) : __glyph_err(__issues);
  },
  schema: __glyph_schema<Plan>("Plan", (v): v is Plan => Plan.is(v), (v: unknown): __GlyphResult<Plan, Issue[]> => Plan.parse(v)),
};

export function label(t: Tier): string {
  const __m0 = t;
  switch (__m0) {
    case "free": {
      return "Free";
    }
    case "pro": {
      return "Pro";
    }
    default: throw new Error("non-exhaustive match");
  }
}
