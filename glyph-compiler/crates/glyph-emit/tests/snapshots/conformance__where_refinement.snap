---
source: crates/glyph-emit/tests/conformance.rs
expression: ts
---
import "./.glyph-runtime/glyph-bootstrap";

import { Ok as __glyph_ok, Err as __glyph_err, type Result as __GlyphResult } from "std/result";

import { schema as __glyph_schema } from "std/schema";

export type Amount = number;
export const Amount = {
  is(value: unknown): value is Amount {
    return (typeof value === "number" && Number.isInteger(value)) && (value >= 0);
  },
  parse(value: unknown): __GlyphResult<Amount, Issue[]> {
    if (!((typeof value === "number" && Number.isInteger(value)))) {
      return __glyph_err([{ path: [], message: "expected Amount (int)", code: "type" }]);
    }
    return (value >= 0)
      ? __glyph_ok(value as Amount)
      : __glyph_err([{ path: [], message: "expected Amount (int where value >= 0)", code: "refinement" }]);
  },
  schema: __glyph_schema<Amount>("Amount", (v): v is Amount => Amount.is(v)),
};

export type Rating = number;
export const Rating = {
  is(value: unknown): value is Rating {
    return (typeof value === "number" && Number.isInteger(value)) && ((value >= 1) && (value <= 5));
  },
  parse(value: unknown): __GlyphResult<Rating, Issue[]> {
    if (!((typeof value === "number" && Number.isInteger(value)))) {
      return __glyph_err([{ path: [], message: "expected Rating (int)", code: "type" }]);
    }
    return ((value >= 1) && (value <= 5))
      ? __glyph_ok(value as Rating)
      : __glyph_err([{ path: [], message: "expected Rating (int where (value >= 1) && (value <= 5))", code: "refinement" }]);
  },
  schema: __glyph_schema<Rating>("Rating", (v): v is Rating => Rating.is(v)),
};

export type NonEmpty = string;
export const NonEmpty = {
  is(value: unknown): value is NonEmpty {
    return typeof value === "string" && (value.length > 0);
  },
  parse(value: unknown): __GlyphResult<NonEmpty, Issue[]> {
    if (!(typeof value === "string")) {
      return __glyph_err([{ path: [], message: "expected NonEmpty (string)", code: "type" }]);
    }
    return (value.length > 0)
      ? __glyph_ok(value as NonEmpty)
      : __glyph_err([{ path: [], message: "expected NonEmpty (string where value.length > 0)", code: "refinement" }]);
  },
  schema: __glyph_schema<NonEmpty>("NonEmpty", (v): v is NonEmpty => NonEmpty.is(v)),
};
