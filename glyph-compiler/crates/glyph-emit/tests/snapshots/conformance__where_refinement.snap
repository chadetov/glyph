import "./.glyph-runtime/glyph-bootstrap";

import { Ok as __glyph_ok, Err as __glyph_err, type Result as __GlyphResult } from "./.glyph-runtime/std/result";

import { schema as __glyph_schema, depth_refused as __glyph_depth_refused } from "./.glyph-runtime/std/schema";

export type Amount = number;
export const Amount = {
  is(value: unknown): value is Amount {
    try {
      return Amount.__is(value, 1);
    } catch (__caught) {
      return __glyph_depth_refused(__caught);
    }
  },
  __is(value: unknown, __d: number): value is Amount {
    return (typeof value === "number" && Number.isInteger(value)) && (value >= 0);
  },
  parse(value: unknown): __GlyphResult<Amount, Issue[]> {
    return Amount.__parse(value, 1);
  },
  __parse(value: unknown, __d: number): __GlyphResult<Amount, Issue[]> {
    if (!((typeof value === "number" && Number.isInteger(value)))) {
      return __glyph_err([{ path: [], message: "expected Amount (int)", code: "type" }]);
    }
    return (value >= 0)
      ? __glyph_ok(value as Amount)
      : __glyph_err([{ path: [], message: "expected Amount (int where value >= 0)", code: "refinement" }]);
  },
  schema: __glyph_schema<Amount>("Amount", (v: unknown, d: number): v is Amount => Amount.__is(v, d), (v: unknown, d: number): __GlyphResult<Amount, Issue[]> => Amount.__parse(v, d)),
};

export type Rating = number;
export const Rating = {
  is(value: unknown): value is Rating {
    try {
      return Rating.__is(value, 1);
    } catch (__caught) {
      return __glyph_depth_refused(__caught);
    }
  },
  __is(value: unknown, __d: number): value is Rating {
    return (typeof value === "number" && Number.isInteger(value)) && ((value >= 1) && (value <= 5));
  },
  parse(value: unknown): __GlyphResult<Rating, Issue[]> {
    return Rating.__parse(value, 1);
  },
  __parse(value: unknown, __d: number): __GlyphResult<Rating, Issue[]> {
    if (!((typeof value === "number" && Number.isInteger(value)))) {
      return __glyph_err([{ path: [], message: "expected Rating (int)", code: "type" }]);
    }
    return ((value >= 1) && (value <= 5))
      ? __glyph_ok(value as Rating)
      : __glyph_err([{ path: [], message: "expected Rating (int where (value >= 1) && (value <= 5))", code: "refinement" }]);
  },
  schema: __glyph_schema<Rating>("Rating", (v: unknown, d: number): v is Rating => Rating.__is(v, d), (v: unknown, d: number): __GlyphResult<Rating, Issue[]> => Rating.__parse(v, d)),
};

export type NonEmpty = string;
export const NonEmpty = {
  is(value: unknown): value is NonEmpty {
    try {
      return NonEmpty.__is(value, 1);
    } catch (__caught) {
      return __glyph_depth_refused(__caught);
    }
  },
  __is(value: unknown, __d: number): value is NonEmpty {
    return typeof value === "string" && (value.length > 0);
  },
  parse(value: unknown): __GlyphResult<NonEmpty, Issue[]> {
    return NonEmpty.__parse(value, 1);
  },
  __parse(value: unknown, __d: number): __GlyphResult<NonEmpty, Issue[]> {
    if (!(typeof value === "string")) {
      return __glyph_err([{ path: [], message: "expected NonEmpty (string)", code: "type" }]);
    }
    return (value.length > 0)
      ? __glyph_ok(value as NonEmpty)
      : __glyph_err([{ path: [], message: "expected NonEmpty (string where value.length > 0)", code: "refinement" }]);
  },
  schema: __glyph_schema<NonEmpty>("NonEmpty", (v: unknown, d: number): v is NonEmpty => NonEmpty.__is(v, d), (v: unknown, d: number): __GlyphResult<NonEmpty, Issue[]> => NonEmpty.__parse(v, d)),
};
