// Credential derivation: turning a password into something safe to store, and
// checking a candidate against it without leaking how far the comparison got.
//
// The derivation is an iterated HMAC-SHA256 keyed by a per-user random salt.
// That is the shape of PBKDF2 without the standard's parameter block; the point
// here is that a stolen table is not a password list and that two users with
// the same password do not share a hash.
module passwords

import std/array
import std/crypto
import std/string

// Work factor. Higher is better and slower; this value keeps the demo
// transcript under a second while still being a real cost per guess.
pub const ROUNDS: int = 4000

pub fn new_salt() -> string {
  return crypto.random_hex(16)
}

pub fn derive(password: string, salt: string) -> string {
  let acc = crypto.hmac_sha256(salt, password)
  for round in array.range(ROUNDS) {
    mut acc = crypto.hmac_sha256(salt, acc)
  }
  return acc
}

pub fn verify(password: string, salt: string, expected: string) -> bool {
  return secure_equals(derive(password, salt), expected)
}

// Compare two strings without an early exit, so the time taken does not depend
// on how many leading characters matched.
//
// The accumulator counts mismatched code units rather than OR-ing their XOR,
// because Glyph has no accessor that turns a code unit into a number: `a[i]` is
// a one-character string, and there is no `string.code_at`. The loop still
// visits every position, which is the property that matters.
pub fn secure_equals(a: string, b: string) -> bool {
  match string.len(a) == string.len(b) {
    true => {},
    false => { return false },
  }
  let diff = 0
  for i in array.range(string.len(a)) {
    mut diff = diff + match a[i] == b[i] {
      true => 0,
      false => 1,
    }
  }
  return diff == 0
}
