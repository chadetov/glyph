module main

import lib

type Order = { id: string }

// A record whose field may be absent. `{ id?: string }` into `{ id: string }`
// is TS2345 and draws nothing from Glyph's own relation, so it is the pairing
// `accepting_rule` must not claim to accept.
type Loose = { id?: string }

// An interface only a `number` satisfies: a `bigint` has no `toFixed`. It is
// how `bigint` against `number` reaches the relation through a member set
// (G500), and the answer is a refusal (record 204).
interface Fx {
  fn toFixed(d: number) -> string
}

// An interface a `bigint` satisfies: every JavaScript value has `toString`.
interface Shows {
  fn toString() -> string
}

fn label(o: Order) -> string {
  return o.id
}

fn tag(v: lib.Id) -> string {
  return v
}

fn widen(o: Order) -> Loose {
  return { id: o.id }
}

fn main(argv: Array<string>) -> number {
  print(label({ id: "a" }))
  print(tag("b"))
  print(widen({ id: "c" }).id)
  return 0
}
