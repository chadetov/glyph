module imported

import lib { label }
import cells { Cell }

// A cross-module alias of a primitive against a `string` parameter. The
// checker follows `Cell`'s chain of names to the `string` at its end (G315),
// so this site is decided as a primitive against a primitive: WILL_FAIL with
// E0211 under a parameter type change (G548).
pub fn probe(c: Cell) -> number {
  return label(c)
}
