module imported

import lib { label }
import cells { Cell }

// A cross-module alias of a primitive against a `string` parameter. The rule
// that decides an imported declaration against a primitive reads a tagged
// union or a record at the end of the declaration's chain of names (G215), and
// `Cell` ends at a `string`, so this site is reached and not decided.
pub fn probe(c: Cell) -> number {
  return label(c)
}
