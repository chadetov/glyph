module neg

// `StorageError.kind` is a string-literal union, so a match over it is
// exhaustive with no `else`, and one that forgets `quota` is refused.
import std/storage

pub fn main() -> void {
  match storage.set("k", "v") {
    Ok(_) => print("saved"),
    Err(e) => match e.kind {
      "unavailable" => print("storage is off"),
    },
  }
}
