module neg

// G217 and G351. `Order { ... }` is the TypeScript-adjacent guess for
// constructing a record and Glyph has no such form: the value is the record
// literal alone and the annotation carries the type. Before E0228 this drew
// one `E0108 unreachable code` warning on the braces and exited 0; from 0.1.142
// to 0.1.145 it drew E0228 and that E0108. A `{` on the line where a statement
// ended is now E0013 at parse, whatever the name before it is.
type Order = {
  id: string,
  total: int,
}

pub fn make() -> Order {
  return Order { id: "a", total: 1 }
}
