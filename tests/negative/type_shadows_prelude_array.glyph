module neg

// `Array` is the one global the emitter references that is also a Glyph
// prelude type. The other four (`Object`, `Error`, `Number`, `Promise`) mean
// nothing in Glyph, so a module may take those names and the emitter captures
// the real global under an alias. This one is different: `Array<string>` is how
// every Glyph program spells an array, so a local declaration does not shadow a
// global the compiler happens to use, it redefines a language type for the rest
// of the module. Capturing cannot help, because the name that changed meaning
// is the one the author writes.
type Array = {
  items: number,
}

fn count(a: Array) -> number {
  return a.items
}
